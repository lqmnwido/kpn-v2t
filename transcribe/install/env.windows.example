# Native Windows template. Copy to repository-root .env and fill your credentials.
# Start with install/start_worker.ps1 so tool names resolve through PATH.
# Server
SERVER_PORT=8082

# Temporal
TEMPORAL_NAMESPACE=default
TEMPORAL_TARGET=127.0.0.1:7233
TEMPORAL_WORKFLOW_TASK_QUEUE=ASR_WORKFLOW_QUEUE
TEMPORAL_MEDIA_TASK_QUEUE=MEDIA_TASK_QUEUE
TEMPORAL_ASR_TASK_QUEUE=ASR_TASK_QUEUE

# MinIO (S3-compatible storage)
MINIO_URL=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=asr-poc

# Ollama (local LLM)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# FFmpeg
FFMPEG_PATH=ffmpeg.exe
FFPROBE_PATH=ffprobe.exe

# Python
# Install both environments with install/setup_cpu.ps1 or setup_gpu.ps1.
PYTHON_EXECUTABLE=python/venv/Scripts/python.exe

# Python script paths (defaults point to python/ directory)
DIARIZE_SCRIPT_PATH=python/diarize_and_match.py
REFINE_SCRIPT_PATH=python/refine_speakers.py

# Working directory for audio processing
ASR_WORK_DIR=./work

# Audio chunk duration in seconds
ASR_CHUNK_SECONDS=30

# Faster-Whisper checkpoint. CUDA uses int8_float16; CPU uses int8.
WHISPER_MODEL=large-v3

# Transcription: ms for Malay-first speech; auto for segment language detection.
# Auto detection can help code-switching but must be compared on your recordings.
ASR_LANGUAGE=ms
# Comma-separated verified names, acronyms and domain terms; leave empty initially.
ASR_HOTWORDS=
# Contextual proofreading uses the existing Ollama service; no correction list.
ASR_PROOFREAD_ENABLED=true
# Optional model override; blank uses OLLAMA_MODEL.
ASR_PROOFREAD_MODEL=
ASR_PROOFREAD_BUDGET_SECONDS=300

# Whole-recording speaker turns (default); ecapa selects the older fallback.
ASR_DIARIZATION_BACKEND=pyannote
# Separate environment keeps pyannote's NumPy 2/PyTorch dependencies out of ASR.
DIARIZATION_PYTHON=python/diarization-venv/Scripts/python.exe
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cpu
DIARIZATION_BATCH_SIZE=1
DIARIZATION_TIMEOUT_SECONDS=5400
# Speaker detection checkpoints each ten-minute core, with context at its edges.
# The subprocess timeout above applies to each speaker window.
DIARIZATION_WINDOW_SECONDS=600
DIARIZATION_OVERLAP_SECONDS=15
DIARIZATION_SPEAKER_THRESHOLD=0.70
DIARIZATION_SPEAKER_MARGIN=0.10
# Required for downloading gated pyannote weights: use your own Hugging Face token
# after accepting the model conditions. Never commit an actual token here.
HF_TOKEN=
PYANNOTE_METRICS_ENABLED=0
# Optional known speaker count; leave empty to estimate.
NUM_SPEAKERS=
MIN_SPEAKERS=
MAX_SPEAKERS=

# Only suspicious segments and segments containing digits get a review pass.
# Empty uses the same Faster-Whisper checkpoint; a different Whisper checkpoint
# may be supplied. Both results are retained; agreement is not verification.
ASR_REVIEW_MODEL=
ASR_MAX_REVIEW_SEGMENTS=8

# Automatic gentle cleanup and measured two-pass loudness normalization.
# No model downloads or GPU required. Custom filters override the ASR copy only.
# The previous default loudnorm=I=-23:TP=-2:LRA=11 also selects auto for compatibility.
# Optional FFmpeg arnndn needs a tested model:
# ASR_AUDIO_FILTER=arnndn=m=/models/noise.rnnn,loudnorm=I=-23:TP=-2:LRA=11
ASR_AUDIO_FILTER=auto

# Optional JSON: names mapped to lists of verified clean mono 16 kHz WAV paths.
# Paths are relative to the JSON file. Matching names remain review candidates.
SPEAKER_REFERENCES_PATH=
SPEAKER_IDENTITY_THRESHOLD=0.75
SPEAKER_IDENTITY_MARGIN=0.10
